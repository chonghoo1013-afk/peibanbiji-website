---
interface Props {
  size?: number;
}
const { size = 120 } = Astro.props;
---
<svg
  class="enso"
  width={size}
  height={size}
  viewBox="0 0 100 100"
  xmlns="http://www.w3.org/2000/svg"
>
  <path
    d="M 82 60 A 35 35 0 1 1 65 27"
    fill="none"
    stroke="var(--moss)"
    stroke-width="7"
    stroke-linecap="round"
  />
</svg>
<style>
  .enso {
    animation: breathe 5s ease-in-out infinite;
  }
  @keyframes breathe {
    0%, 100% { transform: scale(1); opacity: 0.9; }
    50% { transform: scale(1.03); opacity: 1; }
  }
</style>
